                                 .equ	IVSEL	= 1 ; 
                                 .equ	PUD	= 4 ; 
                                 .equ	BODSE	= 5 ; BOD Sleep Enable
                                 .equ	BODS	= 6 ; BOD Sleep
                                 
                                 ; MCUSR - MCU Status Register
                                 .equ	PORF	= 0 ; Power-on reset flag
                                 .equ	EXTRF	= 1 ; External Reset Flag
                                 .equ	BORF	= 2 ; Brown-out Reset Flag
                                 .equ	WDRF	= 3 ; Watchdog Reset Flag
                                 
                                 ; SMCR - Sleep Mode Control Register
                                 .equ	SE	= 0 ; Sleep Enable
                                 .equ	SM0	= 1 ; Sleep Mode Select Bits
                                 .equ	SM1	= 2 ; Sleep Mode Select Bits
                                 .equ	SM2	= 3 ; Sleep Mode Select Bits
                                 
                                 ; GPIOR2 - General Purpose I/O Register 2
                                 .equ	GPIOR20	= 0 ; General Purpose I/O Register 2 Bit 0
                                 .equ	GPIOR21	= 1 ; General Purpose I/O Register 2 Bit 1
                                 .equ	GPIOR22	= 2 ; General Purpose I/O Register 2 Bit 2
                                 .equ	GPIOR23	= 3 ; General Purpose I/O Register 2 Bit 3
                                 .equ	GPIOR24	= 4 ; General Purpose I/O Register 2 Bit 4
                                 .equ	GPIOR25	= 5 ; General Purpose I/O Register 2 Bit 5
                                 .equ	GPIOR26	= 6 ; General Purpose I/O Register 2 Bit 6
                                 .equ	GPIOR27	= 7 ; General Purpose I/O Register 2 Bit 7
                                 
                                 ; GPIOR1 - General Purpose I/O Register 1
                                 .equ	GPIOR10	= 0 ; General Purpose I/O Register 1 Bit 0
                                 .equ	GPIOR11	= 1 ; General Purpose I/O Register 1 Bit 1
                                 .equ	GPIOR12	= 2 ; General Purpose I/O Register 1 Bit 2
                                 .equ	GPIOR13	= 3 ; General Purpose I/O Register 1 Bit 3
                                 .equ	GPIOR14	= 4 ; General Purpose I/O Register 1 Bit 4
                                 .equ	GPIOR15	= 5 ; General Purpose I/O Register 1 Bit 5
                                 .equ	GPIOR16	= 6 ; General Purpose I/O Register 1 Bit 6
                                 .equ	GPIOR17	= 7 ; General Purpose I/O Register 1 Bit 7
                                 
                                 ; GPIOR0 - General Purpose I/O Register 0
                                 .equ	GPIOR00	= 0 ; General Purpose I/O Register 0 Bit 0
                                 .equ	GPIOR01	= 1 ; General Purpose I/O Register 0 Bit 1
                                 .equ	GPIOR02	= 2 ; General Purpose I/O Register 0 Bit 2
                                 .equ	GPIOR03	= 3 ; General Purpose I/O Register 0 Bit 3
                                 .equ	GPIOR04	= 4 ; General Purpose I/O Register 0 Bit 4
                                 .equ	GPIOR05	= 5 ; General Purpose I/O Register 0 Bit 5
                                 .equ	GPIOR06	= 6 ; General Purpose I/O Register 0 Bit 6
                                 .equ	GPIOR07	= 7 ; General Purpose I/O Register 0 Bit 7
                                 
                                 
                                 ; ***** EEPROM *****************
                                 ; EEAR - EEPROM Address Register Bytes
                                 .equ	EEARH0	= 0 ; EEPROM Address Register Bytes High Bit 8
                                 .equ	EEARH1	= 1 ; EEPROM Address Register Bytes High Bit 9
                                 
                                 .equ	EEARL0	= 0 ; EEPROM Address Register Bytes Low Bit 0
                                 .equ	EEARL1	= 1 ; EEPROM Address Register Bytes Low Bit 1
                                 .equ	EEARL2	= 2 ; EEPROM Address Register Bytes Low Bit 2
                                 .equ	EEARL3	= 3 ; EEPROM Address Register Bytes Low Bit 3
                                 .equ	EEARL4	= 4 ; EEPROM Address Register Bytes Low Bit 4
                                 .equ	EEARL5	= 5 ; EEPROM Address Register Bytes Low Bit 5
                                 .equ	EEARL6	= 6 ; EEPROM Address Register Bytes Low Bit 6
                                 .equ	EEARL7	= 7 ; EEPROM Address Register Bytes Low Bit 7
                                 
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0 ; EEPROM Data Register Bit 0
                                 .equ	EEDR1	= 1 ; EEPROM Data Register Bit 1
                                 .equ	EEDR2	= 2 ; EEPROM Data Register Bit 2
                                 .equ	EEDR3	= 3 ; EEPROM Data Register Bit 3
                                 .equ	EEDR4	= 4 ; EEPROM Data Register Bit 4
                                 .equ	EEDR5	= 5 ; EEPROM Data Register Bit 5
                                 .equ	EEDR6	= 6 ; EEPROM Data Register Bit 6
                                 .equ	EEDR7	= 7 ; EEPROM Data Register Bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0 ; EEPROM Read Enable
                                 .equ	EEPE	= 1 ; EEPROM Write Enable
                                 .equ	EEMPE	= 2 ; EEPROM Master Write Enable
                                 .equ	EERIE	= 3 ; EEPROM Ready Interrupt Enable
                                 .equ	EEPM0	= 4 ; EEPROM Programming Mode Bits
                                 .equ	EEPM1	= 5 ; EEPROM Programming Mode Bits
                                 
                                 
                                 ; ***** FUSE *****************
                                 ; EXTENDED - 
                                 .equ	BODLEVEL0	= 0 ; Brown-out Detector trigger level
                                 .equ	BODLEVEL1	= 1 ; Brown-out Detector trigger level
                                 .equ	BODLEVEL2	= 2 ; Brown-out Detector trigger level
                                 .equ	CFD	= 3 ; Clock Failure Detection
                                 
                                 ; HIGH - 
                                 .equ	BOOTRST	= 0 ; Boot Reset vector Enabled
                                 .equ	BOOTSZ0	= 1 ; Select boot size
                                 .equ	BOOTSZ1	= 2 ; Select boot size
                                 .equ	EESAVE	= 3 ; Preserve EEPROM through the Chip Erase cycle
                                 .equ	WDTON	= 4 ; Watch-dog Timer always on
                                 .equ	SPIEN	= 5 ; Serial program downloading (SPI) enabled
                                 .equ	DWEN	= 6 ; Debug Wire enable
                                 .equ	RSTDISBL	= 7 ; Reset Disabled (Enable PC6 as i/o pin)
                                 
                                 ; LOW - 
                                 .equ	SUT_CKSEL0	= 0 ; Select Clock Source
                                 .equ	SUT_CKSEL1	= 1 ; Select Clock Source
                                 .equ	SUT_CKSEL2	= 2 ; Select Clock Source
                                 .equ	SUT_CKSEL3	= 3 ; Select Clock Source
                                 .equ	SUT_CKSEL4	= 4 ; Select Clock Source
                                 .equ	SUT_CKSEL5	= 5 ; Select Clock Source
                                 .equ	CKOUT	= 6 ; Clock output on PORTB0
                                 .equ	CKDIV8	= 7 ; Divide clock by 8 internally
                                 
                                 
                                 ; ***** LOCKBIT *****************
                                 ; LOCKBIT - 
                                 .equ	LB1	= 0 ; Memory Lock
                                 .equ	LB2	= 1 ; Memory Lock
                                 .equ	BLB01	= 2 ; Boot Loader Protection Mode
                                 .equ	BLB02	= 3 ; Boot Loader Protection Mode
                                 .equ	BLB11	= 4 ; Boot Loader Protection Mode
                                 .equ	BLB12	= 5 ; Boot Loader Protection Mode
                                 
                                 
                                 ; ***** CFD *****************
                                 ; XFDCSR - XOSC Failure Detection Control and Status Register
                                 .equ	XFDIE	= 0 ; Failure Detection Interrupt Enable
                                 .equ	XFDIF	= 1 ; Failure Detection Interrupt Flag
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHSTART	= 0x0000 ; Note: Word address
                                 .equ	FLASHEND	= 0x3FFF ; Note: Word address
                                 .equ	FLASHPAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	BOOTSECTION1START	= 0x3F00 ; Note: Word address
                                 .equ	BOOTSECTION1END	= 0x3FFF ; Note: Word address
                                 .equ	BOOTSECTION1PAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	BOOTSECTION2START	= 0x3E00 ; Note: Word address
                                 .equ	BOOTSECTION2END	= 0x3FFF ; Note: Word address
                                 .equ	BOOTSECTION2PAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	BOOTSECTION3START	= 0x3C00 ; Note: Word address
                                 .equ	BOOTSECTION3END	= 0x3FFF ; Note: Word address
                                 .equ	BOOTSECTION3PAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	BOOTSECTION4START	= 0x3800 ; Note: Word address
                                 .equ	BOOTSECTION4END	= 0x3FFF ; Note: Word address
                                 .equ	BOOTSECTION4PAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	IOEND	= 0x00FF
                                 
                                 .equ	SRAM_START	= 0x0100
                                 .equ	SRAM_SIZE	= 2048
                                 .equ	RAMEND	= 0x08FF
                                 
                                 .equ	E2END	= 0x03FF
                                 .equ	EEPROMEND	= 0x03FF
                                 .equ	EEADRBITS	= 10
                                 
                                 .equ	XRAMEND	= 0x0000
                                 
                                 #pragma AVRPART MEMORY PROG_FLASH 32768
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 #pragma AVRPART MEMORY EEPROM 1024
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	PAGESIZE	= 0x0040 ; Note: Size in words
                                 
                                 .equ	FIRSTBOOTSTART	= 0x3F00 ; Note: Word address
                                 .equ	FIRSTBOOTPAGESIZE	= 0x0040 ; Note: Size in words
                                 .equ	FIRSTBOOTEND	= 0x0000 ; Note: Word address
                                 
                                 .equ	SECONDBOOTSTART	= 0x3E00 ; Note: Word address
                                 .equ	SECONDBOOTPAGESIZE	= 0x0040 ; Note: Size in words
                                 .equ	SECONDBOOTEND	= 0x0000 ; Note: Word address
                                 
                                 .equ	THIRDBOOTSTART	= 0x3C00 ; Note: Word address
                                 .equ	THIRDBOOTPAGESIZE	= 0x0040 ; Note: Size in words
                                 .equ	THIRDBOOTEND	= 0x0000 ; Note: Word address
                                 
                                 .equ	FOURTHBOOTSTART	= 0x3800 ; Note: Word address
                                 .equ	FOURTHBOOTPAGESIZE	= 0x0040 ; Note: Size in words
                                 .equ	FOURTHBOOTEND	= 0x0000 ; Note: Word address
                                 
                                 .equ	 SMALLBOOTSTART	= FIRSTBOOTSTART ;
                                 .equ	 LARGEBOOTSTART	= FOURTHBOOTSTART ;
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	 = 0x0002 ; External Interrupt Request 0
                                 .equ	INT1addr	 = 0x0004 ; External Interrupt Request 1
                                 .equ	PCINT0addr	 = 0x0006 ; Pin Change Interrupt Request 0
                                 .equ	PCINT1addr	 = 0x0008 ; Pin Change Interrupt Request 1
                                 .equ	PCINT2addr	 = 0x000A ; Pin Change Interrupt Request 2
                                 .equ	WDTaddr	 = 0x000C ; Watchdog Time-out Interrupt
                                 .equ	TIMER2_COMPAaddr	 = 0x000E ; Timer/Counter2 Compare Match A
                                 .equ	TIMER2_COMPBaddr	 = 0x0010 ; Timer/Counter2 Compare Match B
                                 .equ	TIMER2_OVFaddr	 = 0x0012 ; Timer/Counter2 Overflow
                                 .equ	TIMER1_CAPTaddr	 = 0x0014 ; Timer/Counter1 Capture Event
                                 .equ	TIMER1_COMPAaddr	 = 0x0016 ; Timer/Counter1 Compare Match A
                                 .equ	TIMER1_COMPBaddr	 = 0x0018 ; Timer/Counter1 Compare Match B
                                 .equ	TIMER1_OVFaddr	 = 0x001A ; Timer/Counter1 Overflow
                                 .equ	TIMER0_COMPAaddr	 = 0x001C ; TimerCounter0 Compare Match A
                                 .equ	TIMER0_COMPBaddr	 = 0x001E ; TimerCounter0 Compare Match B
                                 .equ	TIMER0_OVFaddr	 = 0x0020 ; Timer/Couner0 Overflow
                                 .equ	SPI0_STCaddr	 = 0x0022 ; SPI Serial Transfer Complete
                                 .equ	USART0_RXaddr	 = 0x0024 ; USART0 Rx Complete
                                 .equ	USART0_UDREaddr	 = 0x0026 ; USART0, Data Register Empty
                                 .equ	USART0_TXaddr	 = 0x0028 ; USART0 Tx Complete
                                 .equ	ADCaddr	 = 0x002A ; ADC Conversion Complete
                                 .equ	EE_READYaddr	 = 0x002C ; EEPROM Ready
                                 .equ	ANALOG_COMPaddr	 = 0x002E ; Analog Comparator
                                 .equ	TWI0addr	 = 0x0030 ; Two-wire Serial Interface
                                 .equ	SPM_Readyaddr	 = 0x0032 ; Store Program Memory Read
                                 .equ	USART0_STARTaddr	 = 0x0034 ; USART0 Start frame detection
                                 .equ	PCINT3addr	 = 0x0036 ; Pin Change Interrupt Request 3
                                 .equ	USART1_RXaddr	 = 0x0038 ; USART1 Rx Complete
                                 .equ	USART1_UDREaddr	 = 0x003A ; USART1, Data Register Empty
                                 .equ	USART1_TXaddr	 = 0x003C ; USART1 Tx Complete
                                 .equ	USART1_STARTaddr	 = 0x003E ; USART1 Start frame detection
                                 .equ	TIMER3_CAPTaddr	 = 0x0040 ; Timer/Counter3 Capture Event
                                 .equ	TIMER3_COMPAaddr	 = 0x0042 ; Timer/Counter3 Compare Match A
                                 .equ	TIMER3_COMPBaddr	 = 0x0044 ; Timer/Counter3 Compare Match B
                                 .equ	TIMER3_OVFaddr	 = 0x0046 ; Timer/Counter3 Overflow
                                 .equ	CFDaddr	 = 0x0048 ; Clock failure detection interrupt
                                 .equ	PTC_EOCaddr	 = 0x004A ; PTC End of conversion
                                 .equ	PTC_WCOMPaddr	 = 0x004C ; PTC Window comparator mode
                                 .equ	SPI1_STCaddr	 = 0x004E ; SPI1 Serial Transfer Complete
                                 .equ	TWI1addr	 = 0x0050 ; TWI Transfer Complete
                                 .equ	TIMER4_CAPTaddr	 = 0x0052 ; Timer/Counter4 Capture Event
                                 .equ	TIMER4_COMPAaddr	 = 0x0054 ; Timer/Counter4 Compare Match A
                                 .equ	TIMER4_COMPBaddr	 = 0x0056 ; Timer/Counter4 Compare Match B
                                 .equ	TIMER4_OVFaddr	 = 0x0058 ; Timer/Counter4 Overflow
                                 
                                 .equ	INT_VECTORS_SIZE	= 90 ; size in words
                                 
                                 #endif /* _M328PBDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 
                                 
                                 
                                 ; Etapa_4Assembly.asm
                                 ;
                                 ; Botón Start en PD3 usando interrupción INT1
                                 ; Matriz 8x8 usando dos decodificadores 4:10
                                 ; Timer0: multiplexado de matriz
                                 ; Timer1: contador de segundos y descenso de obstáculos
                                 ;
                                 
                                 .include "m328PBdef.inc"
                                 
                                 
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;*
                                 ;* Number            : AVR000
                                 ;* File Name         : m328PBdef.inc
                                 ;* Title             : Register/Bit Definitions for the ATmega328PB
                                 ;* Created           : 2021-07-13 10:39
                                 ;* Version           : 1.00
                                 ;* Support e-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328PB
                                 ;*
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal
                                 ;* SRAM is also defined
                                 ;*
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PBDEF_INC_
                                 #endif /* _M328PBDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 
                                 
                                 
                                 ;***********************************************
                                 ; Variables en memoria RAM
                                 ;***********************************************
                                 .dseg
000100                           juego_activo:  .byte 1
000101                           pixel_actual:  .byte 1
000102                           unidades:      .byte 1
000103                           decenas:       .byte 1
000104                           pos_carro:     .byte 1
000105                           boton_lock:    .byte 1
000106                           obstaculo1_y:  .byte 1
000107                           obstaculo2_y:  .byte 1
                                 
                                 ;***********************************************
                                 ; Segmento de código
                                 ;***********************************************
                                 .cseg
                                 
                                 .org 0x0000
000000 c03f                          rjmp RESET               ; Vector de reset
                                 
                                 .org 0x0004
000004 c085                          rjmp START               ; Vector de interrupción externa INT1
                                 
                                 .org 0x0016
000016 c0cb                          rjmp ISR_TIMER1_COMPA    ; Vector Timer/Counter1 Compare Match A
                                 
                                 .org 0x001C
00001c c097                          rjmp ISR_TIMER0_COMPA    ; Vector Timer0 Compare Match A
                                 
                                 .org 0x0040                  ; Evita solapamiento con vectores
                                 
                                 ;***********************************************
                                 RESET:
                                 
                                     ;-------------------------------------------
                                     ; Inicializar Stack Pointer
                                     ; Necesario para rcall, ret e interrupciones
                                     ;-------------------------------------------
000040 e008                          ldi r16, HIGH(RAMEND)
000041 bf0e                          out SPH, r16
                                 
000042 ef0f                          ldi r16, LOW(RAMEND)
000043 bf0d                          out SPL, r16
                                 
                                     ;-------------------------------------------
                                     ; PORTB para displays BCDTo7S
                                     ; PB0-PB3 = decenas
                                     ; PB4-PB7 = unidades
                                     ;-------------------------------------------
000044 ef0f                          ldi r16, 0xFF
000045 b904                          out DDRB, r16
                                 
000046 e000                          ldi r16, 0x00
000047 b905                          out PORTB, r16
                                 
                                     ;-------------------------------------------
                                     ; Configurar PORTC
                                     ;
                                     ; Columnas:
                                     ; PC2 -> S3
                                     ; PC3 -> S2
                                     ; PC4 -> S1
                                     ; PC5 -> S0
                                     ;
                                     ; Filas:
                                     ; PC6 -> S3 del decodificador de filas
                                     ;
                                     ; PC1 se mantiene en 1 hasta Start
                                     ;-------------------------------------------
000048 e72e                          ldi r18, 0b01111110
000049 b927                          out DDRC, r18
                                 
                                     ;-------------------------------------------
                                     ; Configurar PORTD
                                     ;
                                     ; PD0 -> S2 filas
                                     ; PD1 -> S1 filas
                                     ; PD2 -> S0 filas
                                     ; PD3 -> Start / INT1
                                     ; PD4 -> botón derecha
                                     ;-------------------------------------------
00004a e027                          ldi r18, 0b00000111
00004b b92a                          out DDRD, r18
                                 
00004c 9853                          cbi DDRD, 3             ; PD3 como entrada
00004d 9854                          cbi DDRD, 4             ; PD4 como entrada
                                 
00004e 985b                          cbi PORTD, 3            ; Sin pull-up interna
00004f 985c                          cbi PORTD, 4            ; Sin pull-up interna
                                 
                                     ;-------------------------------------------
                                     ; PE0 = botón izquierda
                                     ;-------------------------------------------
000050 9868                          cbi DDRE, 0             ; PE0 como entrada
000051 9870                          cbi PORTE, 0            ; Sin pull-up interna
                                 
                                     ;-------------------------------------------
                                     ; Apagar matriz inicialmente
                                     ; PC6 = 1 y PC1 = 1
                                     ;-------------------------------------------
000052 e422                          ldi r18, 0b01000010
000053 b928                          out PORTC, r18
                                 
000054 e020                          ldi r18, 0b00000000
000055 b92b                          out PORTD, r18
                                 
                                     ;-------------------------------------------
                                     ; Variables iniciales
                                     ;-------------------------------------------
000056 e000                          ldi r16, 0x00
000057 9300 0100                     sts juego_activo, r16
000059 9300 0101                     sts pixel_actual, r16
00005b 9300 0102                     sts unidades, r16
00005d 9300 0103                     sts decenas, r16
                                 
                                     ; Posición inicial del carro en el centro
00005f e003                          ldi r16, 3
000060 9300 0104                     sts pos_carro, r16
                                 
                                     ; Botones desbloqueados
000062 e000                          ldi r16, 0
000063 9300 0105                     sts boton_lock, r16
                                 
                                     ; Obstáculo 1 inicia arriba
000065 e000                          ldi r16, 0
000066 9300 0106                     sts obstaculo1_y, r16
                                 
                                     ; Obstáculo 2 inicia más abajo para que no aparezcan juntos
000068 e004                          ldi r16, 4
000069 9300 0107                     sts obstaculo2_y, r16
                                 
                                     ;-------------------------------------------
                                     ; Configurar INT1 por flanco de subida
                                     ; Sin pull-up:
                                     ; sin presionar = 0
                                     ; presionado    = 1
                                     ;-------------------------------------------
00006b e00c                          ldi r16, 0b00001100
00006c 9300 0069                     sts EICRA, r16
                                 
                                     ; Limpiar bandera INT1
00006e e002                          ldi r16, 0b00000010
00006f 9300 001c                     sts EIFR, r16
                                 
                                     ; Habilitar INT1
000071 e002                          ldi r16, 0b00000010
000072 bb0d                          out EIMSK, r16
                                 
                                     ;-------------------------------------------
                                     ; Configurar Timer0 en modo CTC
                                     ; Timer0 refresca la matriz LED
                                     ;-------------------------------------------
000073 e002                          ldi r16, 0b00000010
000074 bd04                          out TCCR0A, r16
                                 
000075 ef0a                          ldi r16, 250
000076 bd07                          out OCR0A, r16
                                 
000077 e002                          ldi r16, 0b00000010
000078 9300 006e                     sts TIMSK0, r16
                                 
                                     ; Prescaler 64
00007a e003                          ldi r16, 0b00000011
00007b bd05                          out TCCR0B, r16
                                 
                                     ;-------------------------------------------
                                     ; Configurar Timer1 en modo CTC
                                     ; Timer1 cuenta segundos reales
                                     ;
                                     ; Para 16 MHz con prescaler 1024:
                                     ; 16.000.000 / 1024 = 15625 cuentas por segundo
                                     ; Como cuenta desde 0, usamos OCR1A = 15624
                                     ;-------------------------------------------
00007c e30d                          ldi r16, HIGH(15624)
00007d 9300 0089                     sts OCR1AH, r16
                                 
00007f e008                          ldi r16, LOW(15624)
000080 9300 0088                     sts OCR1AL, r16
                                 
                                     ; WGM12 = 1, CS12 = 1, CS10 = 1
                                     ; Modo CTC + prescaler 1024
000082 e00d                          ldi r16, 0b00001101
000083 9300 0081                     sts TCCR1B, r16
                                 
                                     ; OCIE1A = 1
000085 e002                          ldi r16, 0b00000010
000086 9300 006f                     sts TIMSK1, r16
                                 
                                     ;-------------------------------------------
                                     ; Habilitar interrupciones globales
                                     ;-------------------------------------------
000088 9478                          sei
                                 
                                 ;***********************************************
                                 MAIN:
000089 cfff                          rjmp MAIN
                                 
                                 ;***********************************************
                                 ; START
                                 ; Se ejecuta cuando PD3 recibe flanco de subida
                                 ;***********************************************
                                 START:
                                 
                                     ; PC1 pasa a 0 cuando inicia el juego
00008a 9841                          cbi PORTC, 1
                                 
                                     ; Reactivar Timer0 para refrescar la matriz
00008b e003                          ldi r16, 0b00000011
00008c bd05                          out TCCR0B, r16
                                 
                                     ; Reiniciar Timer1
00008d e000                          ldi r16, 0x00
00008e 9300 0085                     sts TCNT1H, r16
000090 9300 0084                     sts TCNT1L, r16
                                 
                                     ; Limpiar bandera de comparación de Timer1
000092 e002                          ldi r16, 0b00000010
000093 9300 0016                     sts TIFR1, r16
                                 
                                 	; Reactivar Timer1
                                     ; WGM12 = 1, CS12 = 1, CS10 = 1
                                     ; Modo CTC + prescaler 1024
000095 e00d                          ldi r16, 0b00001101
000096 9300 0081                     sts TCCR1B, r16
                                 
                                     ; Reactivar Timer1
                                     ; WGM12 = 1, CS12 = 1, CS10 = 1
                                     ; Modo CTC + prescaler 1024
000098 e00d                          ldi r16, 0b00001101
000099 9300 0081                     sts TCCR1B, r16
                                 
                                     ; Activar juego
00009b e001                          ldi r16, 0x01
00009c 9300 0100                     sts juego_activo, r16
                                 
                                     ; Iniciar desde el primer pixel
00009e e000                          ldi r16, 0x00
00009f 9300 0101                     sts pixel_actual, r16
                                 
                                     ; Reiniciar contador a 00
0000a1 e000                          ldi r16, 0x00
0000a2 9300 0102                     sts unidades, r16
0000a4 9300 0103                     sts decenas, r16
                                 
                                     ; Vehículo al centro
0000a6 e003                          ldi r16, 3
0000a7 9300 0104                     sts pos_carro, r16
                                 
                                     ; Desbloquear botones
0000a9 e000                          ldi r16, 0
0000aa 9300 0105                     sts boton_lock, r16
                                 
                                     ; Reiniciar obstáculos
0000ac e000                          ldi r16, 0
0000ad 9300 0106                     sts obstaculo1_y, r16
                                 
0000af e004                          ldi r16, 4
0000b0 9300 0107                     sts obstaculo2_y, r16
                                 
                                     ; Mostrar 00 en displays
0000b2 d096                          rcall MOSTRAR_DISPLAY
                                 
0000b3 9518                          reti
                                 
                                 ;***********************************************
                                 ; ISR_TIMER0_COMPA
                                 ; Refresca matriz y lee botones
                                 ;***********************************************
                                 ISR_TIMER0_COMPA:
                                 
                                     ; Verificar estado del juego
0000b4 9100 0100                     lds r16, juego_activo
                                 
                                     ; 1 = juego activo
0000b6 3001                          cpi r16, 0x01
0000b7 f019                          breq TIMER0_JUGANDO
                                 
                                     ; 2 = juego terminado por choque
                                     ; Se sigue refrescando la matriz,
                                     ; pero no se leen botones
0000b8 3002                          cpi r16, 0x02
0000b9 f019                          breq TIMER0_CONGELADO
                                 
                                     ; 0 = juego detenido antes de iniciar
0000ba c072                          rjmp APAGAR_MATRIZ
                                 
                                 TIMER0_JUGANDO:
                                 
                                     ; Solo durante el juego activo se leen botones
0000bb d098                          rcall LEER_BOTONES
                                 
0000bc c001                          rjmp DIBUJAR_MATRIZ
                                 
                                 TIMER0_CONGELADO:
                                 
                                     ; No leer botones.
                                     ; Se conserva la última posición del vehículo
                                     ; y de los obstáculos.
0000bd c000                          rjmp DIBUJAR_MATRIZ
                                 
                                 DIBUJAR_MATRIZ:
                                 
                                     ; Leer cuál pixel toca mostrar
0000be 9100 0101                     lds r16, pixel_actual
                                 
                                 CONTINUAR_TIMER0:
                                 
0000c0 d093                          rcall LEER_BOTONES
                                 
                                     ; Leer cuál pixel toca mostrar
0000c1 9100 0101                     lds r16, pixel_actual
                                 
0000c3 3000                          cpi r16, 0
0000c4 f099                          breq SALTAR_PIXEL_0
                                 
0000c5 3001                          cpi r16, 1
0000c6 f091                          breq SALTAR_PIXEL_1
                                 
0000c7 3002                          cpi r16, 2
0000c8 f089                          breq SALTAR_PIXEL_2
                                 
0000c9 3003                          cpi r16, 3
0000ca f081                          breq SALTAR_OBS1_0
                                 
0000cb 3004                          cpi r16, 4
0000cc f079                          breq SALTAR_OBS1_1
                                 
0000cd 3005                          cpi r16, 5
0000ce f071                          breq SALTAR_OBS1_2
                                 
0000cf 3006                          cpi r16, 6
0000d0 f069                          breq SALTAR_OBS2_0
                                 
0000d1 3007                          cpi r16, 7
0000d2 f061                          breq SALTAR_OBS2_1
                                 
0000d3 3008                          cpi r16, 8
0000d4 f059                          breq SALTAR_OBS2_2
                                 
0000d5 3009                          cpi r16, 9
0000d6 f051                          breq SALTAR_OBS2_3
                                 
0000d7 c051                          rjmp REINICIAR_PIXEL
                                 
                                 ; Saltos intermedios para evitar Relative branch out of reach
                                 
                                 SALTAR_PIXEL_0:
0000d8 c016                          rjmp MOSTRAR_PIXEL_0
                                 
                                 SALTAR_PIXEL_1:
0000d9 c01b                          rjmp MOSTRAR_PIXEL_1
                                 
                                 SALTAR_PIXEL_2:
0000da c01f                          rjmp MOSTRAR_PIXEL_2
                                 
                                 SALTAR_OBS1_0:
0000db c025                          rjmp MOSTRAR_OBS1_0
                                 
                                 SALTAR_OBS1_1:
0000dc c029                          rjmp MOSTRAR_OBS1_1
                                 
                                 SALTAR_OBS1_2:
0000dd c02d                          rjmp MOSTRAR_OBS1_2
                                 
                                 SALTAR_OBS2_0:
0000de c031                          rjmp MOSTRAR_OBS2_0
                                 
                                 SALTAR_OBS2_1:
0000df c035                          rjmp MOSTRAR_OBS2_1
                                 
                                 SALTAR_OBS2_2:
0000e0 c039                          rjmp MOSTRAR_OBS2_2
                                 
                                 SALTAR_OBS2_3:
0000e1 c03d                          rjmp MOSTRAR_OBS2_3
                                 
                                 ;***********************************************
                                 ; ISR_TIMER1_COMPA
                                 ; Cada segundo actualiza contador y baja obstáculos
                                 ;***********************************************
                                 ISR_TIMER1_COMPA:
                                 
                                     ; Verificar si el juego está activo
0000e2 9100 0100                     lds r16, juego_activo
0000e4 3001                          cpi r16, 0x01
0000e5 f009                          breq CONTINUAR_TIMER1
                                 
0000e6 c007                          rjmp FIN_TIMER1
                                 
                                 CONTINUAR_TIMER1:
                                 
                                     ; Primero bajan los obstáculos
0000e7 d09c                          rcall MOVER_OBSTACULOS
                                 
                                     ; Luego se verifica si chocaron con el vehículo
0000e8 d0ac                          rcall VERIFICAR_CHOQUE
                                 
                                     ; Si hubo choque, juego_activo queda en 0
                                     ; y no se actualiza el contador
0000e9 9100 0100                     lds r16, juego_activo
0000eb 3001                          cpi r16, 0x01
0000ec f409                          brne FIN_TIMER1
                                 
                                     ; Si no hubo choque, aumenta el reloj
0000ed d045                          rcall ACTUALIZAR_CONTADOR
                                 
                                 FIN_TIMER1:
0000ee 9518                          reti
                                 
                                 ;***********************************************
                                 ; Pixel 0 del vehículo
                                 ; Fila 6, columna pos_carro + 1
                                 ;***********************************************
                                 MOSTRAR_PIXEL_0:
                                 
0000ef 9140 0104                     lds r20, pos_carro
0000f1 9543                          inc r20
                                 
0000f2 e056                          ldi r21, 6
0000f3 d0f2                          rcall MOSTRAR_LED
                                 
0000f4 c02f                          rjmp AVANZAR_PIXEL
                                 
                                 ;***********************************************
                                 ; Pixel 1 del vehículo
                                 ; Fila 7, columna pos_carro
                                 ;***********************************************
                                 MOSTRAR_PIXEL_1:
                                 
0000f5 9140 0104                     lds r20, pos_carro
                                 
0000f7 e057                          ldi r21, 7
0000f8 d0ed                          rcall MOSTRAR_LED
                                 
0000f9 c02a                          rjmp AVANZAR_PIXEL
                                 
                                 ;***********************************************
                                 ; Pixel 2 del vehículo
                                 ; Fila 7, columna pos_carro + 2
                                 ;***********************************************
                                 MOSTRAR_PIXEL_2:
                                 
0000fa 9140 0104                     lds r20, pos_carro
0000fc 9543                          inc r20
0000fd 9543                          inc r20
                                 
0000fe e057                          ldi r21, 7
0000ff d0e6                          rcall MOSTRAR_LED
                                 
000100 c023                          rjmp AVANZAR_PIXEL
                                 
                                 ;***********************************************
                                 ; Obstáculo 1: barra horizontal de 3 píxeles
                                 ; Columnas 2, 3 y 4
                                 ; Fila = obstaculo1_y
                                 ;***********************************************
                                 MOSTRAR_OBS1_0:
                                 
000101 e042                          ldi r20, 2
000102 9150 0106                     lds r21, obstaculo1_y
000104 d0e1                          rcall MOSTRAR_LED
                                 
000105 c01e                          rjmp AVANZAR_PIXEL
                                 
                                 MOSTRAR_OBS1_1:
                                 
000106 e043                          ldi r20, 3
000107 9150 0106                     lds r21, obstaculo1_y
000109 d0dc                          rcall MOSTRAR_LED
                                 
00010a c019                          rjmp AVANZAR_PIXEL
                                 
                                 MOSTRAR_OBS1_2:
                                 
00010b e044                          ldi r20, 4
00010c 9150 0106                     lds r21, obstaculo1_y
00010e d0d7                          rcall MOSTRAR_LED
                                 
00010f c014                          rjmp AVANZAR_PIXEL
                                 
                                 ;***********************************************
                                 ; Obstáculo 2: barra horizontal de 4 píxeles
                                 ; Columnas 3, 4, 5 y 6
                                 ; Fila = obstaculo2_y
                                 ;***********************************************
                                 MOSTRAR_OBS2_0:
                                 
000110 e043                          ldi r20, 3
000111 9150 0107                     lds r21, obstaculo2_y
000113 d0d2                          rcall MOSTRAR_LED
                                 
000114 c00f                          rjmp AVANZAR_PIXEL
                                 
                                 MOSTRAR_OBS2_1:
                                 
000115 e044                          ldi r20, 4
000116 9150 0107                     lds r21, obstaculo2_y
000118 d0cd                          rcall MOSTRAR_LED
                                 
000119 c00a                          rjmp AVANZAR_PIXEL
                                 
                                 MOSTRAR_OBS2_2:
                                 
00011a e045                          ldi r20, 5
00011b 9150 0107                     lds r21, obstaculo2_y
00011d d0c8                          rcall MOSTRAR_LED
                                 
00011e c005                          rjmp AVANZAR_PIXEL
                                 
                                 MOSTRAR_OBS2_3:
                                 
00011f e046                          ldi r20, 6
000120 9150 0107                     lds r21, obstaculo2_y
000122 d0c3                          rcall MOSTRAR_LED
                                 
000123 c000                          rjmp AVANZAR_PIXEL
                                 
                                 ;***********************************************
                                 ; Avanzar pixel del multiplexado
                                 ; Hay 10 píxeles:
                                 ; 3 vehículo + 3 obstáculo1 + 4 obstáculo2
                                 ;***********************************************
                                 AVANZAR_PIXEL:
                                 
000124 9100 0101                     lds r16, pixel_actual
000126 9503                          inc r16
                                 
000127 300a                          cpi r16, 10
000128 f008                          brlo GUARDAR_PIXEL
                                 
                                 REINICIAR_PIXEL:
000129 e000                          ldi r16, 0
                                 
                                 GUARDAR_PIXEL:
00012a 9300 0101                     sts pixel_actual, r16
00012c c005                          rjmp FIN_TIMER0
                                 
                                 ;***********************************************
                                 APAGAR_MATRIZ:
                                 
                                     ; PC6 = 1 para fila 8 apagada
                                     ; PC1 = 1 mientras no se presiona Start
00012d e422                          ldi r18, 0b01000010
00012e b928                          out PORTC, r18
                                 
00012f e020                          ldi r18, 0b00000000
000130 b92b                          out PORTD, r18
                                 
000131 c000                          rjmp FIN_TIMER0
                                 
                                 ;***********************************************
                                 FIN_TIMER0:
000132 9518                          reti
                                 
                                 ;***********************************************
                                 ; ACTUALIZAR_CONTADOR
                                 ; 00, 01, 02 ... 99, 00
                                 ;***********************************************
                                 ACTUALIZAR_CONTADOR:
                                 
                                     ; Aumentar unidades
000133 9100 0102                     lds r16, unidades
000135 9503                          inc r16
                                 
000136 300a                          cpi r16, 10
000137 f068                          brlo GUARDAR_UNIDADES
                                 
                                     ; Si unidades llegó a 10, vuelve a 0
000138 e000                          ldi r16, 0x00
000139 9300 0102                     sts unidades, r16
                                 
                                     ; Aumentar decenas
00013b 9110 0103                     lds r17, decenas
00013d 9513                          inc r17
                                 
00013e 301a                          cpi r17, 10
00013f f008                          brlo GUARDAR_DECENAS
                                 
                                     ; Si decenas llegó a 10, vuelve a 0
000140 e010                          ldi r17, 0x00
                                 
                                 GUARDAR_DECENAS:
000141 9310 0103                     sts decenas, r17
000143 d005                          rcall MOSTRAR_DISPLAY
000144 9508                          ret
                                 
                                 GUARDAR_UNIDADES:
000145 9300 0102                     sts unidades, r16
000147 d001                          rcall MOSTRAR_DISPLAY
000148 9508                          ret
                                 
                                 ;***********************************************
                                 ; MOSTRAR_DISPLAY
                                 ;
                                 ; PB0-PB3 = DECENAS
                                 ; PB4-PB7 = UNIDADES
                                 ;***********************************************
                                 MOSTRAR_DISPLAY:
                                 
                                     ; Cargar unidades en r17
000149 9110 0102                     lds r17, unidades
                                 
                                     ; Cargar decenas en r16
00014b 9100 0103                     lds r16, decenas
                                 
                                     ; Mover unidades a la parte alta del byte
00014d 0f11                          lsl r17
00014e 0f11                          lsl r17
00014f 0f11                          lsl r17
000150 0f11                          lsl r17
                                 
                                     ; Unir unidades y decenas
000151 2b01                          or r16, r17
                                 
                                     ; Enviar a los BcdTo7S
000152 b905                          out PORTB, r16
                                 
000153 9508                          ret
                                 
                                 ;***********************************************
                                 ; LEER_BOTONES
                                 ;
                                 ; PE0 = izquierda
                                 ; PD4 = derecha
                                 ;
                                 ; Sin pull-up:
                                 ; sin presionar = 0
                                 ; presionado    = 1
                                 ;***********************************************
                                 LEER_BOTONES:
                                     ; Si el juego no está activo, no leer botones
000154 9100 0100                     lds r16, juego_activo
000156 3001                          cpi r16, 0x01
000157 f009                          breq CONTINUAR_LEYENDO_BOTONES
000158 9508                          ret
                                 
                                 CONTINUAR_LEYENDO_BOTONES:
                                 
                                     ; Si los botones están bloqueados,
                                     ; verificar si ya se soltaron
000159 9100 0105                     lds r16, boton_lock
00015b 3001                          cpi r16, 1
00015c f079                          breq VERIFICAR_SOLTAR_BOTONES
                                 
                                     ; Revisar botón izquierda PE0
00015d 9960                          sbic PINE, 0
00015e c003                          rjmp BOTON_IZQUIERDA_PRESIONADO
                                 
                                     ; Revisar botón derecha PD4
00015f 994c                          sbic PIND, 4
000160 c006                          rjmp BOTON_DERECHA_PRESIONADO
                                 
000161 9508                          ret
                                 
                                 BOTON_IZQUIERDA_PRESIONADO:
                                 
000162 d011                          rcall MOVER_IZQUIERDA
                                 
000163 e001                          ldi r16, 1
000164 9300 0105                     sts boton_lock, r16
                                 
000166 9508                          ret
                                 
                                 BOTON_DERECHA_PRESIONADO:
                                 
000167 d014                          rcall MOVER_DERECHA
                                 
000168 e001                          ldi r16, 1
000169 9300 0105                     sts boton_lock, r16
                                 
00016b 9508                          ret
                                 
                                 VERIFICAR_SOLTAR_BOTONES:
                                 
                                     ; Si PE0 sigue en 1, todavía está presionado
00016c 9960                          sbic PINE, 0
00016d 9508                          ret
                                 
                                     ; Si PD4 sigue en 1, todavía está presionado
00016e 994c                          sbic PIND, 4
00016f 9508                          ret
                                 
                                     ; Si ambos están en 0, desbloquear botones
000170 e000                          ldi r16, 0
000171 9300 0105                     sts boton_lock, r16
                                 
000173 9508                          ret
                                 
                                 ;***********************************************
                                 ; MOVER_IZQUIERDA
                                 ; Límite izquierdo: pos_carro = 0
                                 ;***********************************************
                                 MOVER_IZQUIERDA:
                                 
000174 9100 0104                     lds r16, pos_carro
                                 
000176 3000                          cpi r16, 0
000177 f019                          breq FIN_MOVER_IZQUIERDA
                                 
000178 950a                          dec r16
000179 9300 0104                     sts pos_carro, r16
                                 
                                 FIN_MOVER_IZQUIERDA:
00017b 9508                          ret
                                 
                                 ;***********************************************
                                 ; MOVER_DERECHA
                                 ; Límite derecho: pos_carro = 5
                                 ;***********************************************
                                 MOVER_DERECHA:
                                 
00017c 9100 0104                     lds r16, pos_carro
                                 
00017e 3005                          cpi r16, 5
00017f f019                          breq FIN_MOVER_DERECHA
                                 
000180 9503                          inc r16
000181 9300 0104                     sts pos_carro, r16
                                 
                                 FIN_MOVER_DERECHA:
000183 9508                          ret
                                 
                                 ;***********************************************
                                 ; MOVER_OBSTACULOS
                                 ; Baja cada obstáculo una fila por segundo
                                 ;***********************************************
                                 MOVER_OBSTACULOS:
                                 
                                     ;-------------------------------------------
                                     ; Obstáculo 1
                                     ;-------------------------------------------
000184 9100 0106                     lds r16, obstaculo1_y
000186 9503                          inc r16
                                 
000187 3008                          cpi r16, 8
000188 f008                          brlo GUARDAR_OBSTACULO1
                                 
000189 e000                          ldi r16, 0
                                 
                                 GUARDAR_OBSTACULO1:
00018a 9300 0106                     sts obstaculo1_y, r16
                                 
                                     ;-------------------------------------------
                                     ; Obstáculo 2
                                     ;-------------------------------------------
00018c 9100 0107                     lds r16, obstaculo2_y
00018e 9503                          inc r16
                                 
00018f 3008                          cpi r16, 8
000190 f008                          brlo GUARDAR_OBSTACULO2
                                 
000191 e000                          ldi r16, 0
                                 
                                 GUARDAR_OBSTACULO2:
000192 9300 0107                     sts obstaculo2_y, r16
                                 
000194 9508                          ret
                                 
                                 ;***********************************************
                                 ; VERIFICAR_CHOQUE
                                 ;
                                 ; Vehículo:
                                 ;   Pixel superior: fila 6, columna pos_carro + 1
                                 ;   Pixel inferior izquierdo: fila 7, columna pos_carro
                                 ;   Pixel inferior derecho: fila 7, columna pos_carro + 2
                                 ;
                                 ; Obstáculo 1:
                                 ;   Fila obstaculo1_y
                                 ;   Columnas 2, 3 y 4
                                 ;
                                 ; Obstáculo 2:
                                 ;   Fila obstaculo2_y
                                 ;   Columnas 3, 4, 5 y 6
                                 ;***********************************************
                                 VERIFICAR_CHOQUE:
                                 
000195 d006                          rcall VERIFICAR_CHOQUE_OBSTACULO1
                                 
                                     ; Si ya hubo choque, no revisar más
000196 9100 0100                     lds r16, juego_activo
000198 3000                          cpi r16, 0x00
000199 f009                          breq FIN_VERIFICAR_CHOQUE
                                 
00019a d020                          rcall VERIFICAR_CHOQUE_OBSTACULO2
                                 
                                 FIN_VERIFICAR_CHOQUE:
00019b 9508                          ret
                                 
                                 ;***********************************************
                                 ; VERIFICAR_CHOQUE_OBSTACULO1
                                 ; Obstáculo 1: columnas 2, 3 y 4
                                 ;***********************************************
                                 VERIFICAR_CHOQUE_OBSTACULO1:
                                 
00019c 9100 0106                     lds r16, obstaculo1_y
                                 
                                     ; Si el obstáculo está en fila 6,
                                     ; puede chocar con el pixel superior del vehículo
00019e 3006                          cpi r16, 6
00019f f019                          breq OBS1_FILA6
                                 
                                     ; Si el obstáculo está en fila 7,
                                     ; puede chocar con los dos pixeles inferiores
0001a0 3007                          cpi r16, 7
0001a1 f051                          breq OBS1_FILA7
                                 
0001a2 9508                          ret
                                 
                                 OBS1_FILA6:
                                 
                                     ; Pixel superior del vehículo:
                                     ; columna = pos_carro + 1
                                     ;
                                     ; Para chocar con columnas 2, 3 o 4:
                                     ; pos_carro debe ser 1, 2 o 3
                                 
0001a3 9110 0104                     lds r17, pos_carro
                                 
0001a5 3011                          cpi r17, 1
0001a6 f091                          breq OBS1_CHOQUE
                                 
0001a7 3012                          cpi r17, 2
0001a8 f081                          breq OBS1_CHOQUE
                                 
0001a9 3013                          cpi r17, 3
0001aa f071                          breq OBS1_CHOQUE
                                 
0001ab 9508                          ret
                                 
                                 OBS1_FILA7:
                                 
                                     ; Pixeles inferiores del vehículo:
                                     ; columna izquierda = pos_carro
                                     ; columna derecha   = pos_carro + 2
                                     ;
                                     ; Para chocar con columnas 2, 3 o 4:
                                     ; pos_carro puede ser 0, 1, 2, 3 o 4
                                 
0001ac 9110 0104                     lds r17, pos_carro
                                 
0001ae 3010                          cpi r17, 0
0001af f049                          breq OBS1_CHOQUE
                                 
0001b0 3011                          cpi r17, 1
0001b1 f039                          breq OBS1_CHOQUE
                                 
0001b2 3012                          cpi r17, 2
0001b3 f029                          breq OBS1_CHOQUE
                                 
0001b4 3013                          cpi r17, 3
0001b5 f019                          breq OBS1_CHOQUE
                                 
0001b6 3014                          cpi r17, 4
0001b7 f009                          breq OBS1_CHOQUE
                                 
0001b8 9508                          ret
                                 
                                 OBS1_CHOQUE:
                                 
0001b9 d022                          rcall DETENER_JUEGO
0001ba 9508                          ret
                                 
                                 ;***********************************************
                                 ; VERIFICAR_CHOQUE_OBSTACULO2
                                 ; Obstáculo 2: columnas 3, 4, 5 y 6
                                 ;***********************************************
                                 VERIFICAR_CHOQUE_OBSTACULO2:
                                 
0001bb 9100 0107                     lds r16, obstaculo2_y
                                 
                                     ; Si el obstáculo está en fila 6,
                                     ; puede chocar con el pixel superior del vehículo
0001bd 3006                          cpi r16, 6
0001be f019                          breq OBS2_FILA6
                                 
                                     ; Si el obstáculo está en fila 7,
                                     ; puede chocar con los dos pixeles inferiores
0001bf 3007                          cpi r16, 7
0001c0 f061                          breq OBS2_FILA7
                                 
0001c1 9508                          ret
                                 
                                 OBS2_FILA6:
                                 
                                     ; Pixel superior del vehículo:
                                     ; columna = pos_carro + 1
                                     ;
                                     ; Para chocar con columnas 3, 4, 5 o 6:
                                     ; pos_carro debe ser 2, 3, 4 o 5
                                 
0001c2 9110 0104                     lds r17, pos_carro
                                 
0001c4 3012                          cpi r17, 2
0001c5 f0a1                          breq OBS2_CHOQUE
                                 
0001c6 3013                          cpi r17, 3
0001c7 f091                          breq OBS2_CHOQUE
                                 
0001c8 3014                          cpi r17, 4
0001c9 f081                          breq OBS2_CHOQUE
                                 
0001ca 3015                          cpi r17, 5
0001cb f071                          breq OBS2_CHOQUE
                                 
0001cc 9508                          ret
                                 
                                 OBS2_FILA7:
                                 
                                     ; Pixeles inferiores del vehículo:
                                     ; columna izquierda = pos_carro
                                     ; columna derecha   = pos_carro + 2
                                     ;
                                     ; Para chocar con columnas 3, 4, 5 o 6:
                                     ; pos_carro puede ser 1, 2, 3, 4 o 5
                                 
0001cd 9110 0104                     lds r17, pos_carro
                                 
0001cf 3011                          cpi r17, 1
0001d0 f049                          breq OBS2_CHOQUE
                                 
0001d1 3012                          cpi r17, 2
0001d2 f039                          breq OBS2_CHOQUE
                                 
0001d3 3013                          cpi r17, 3
0001d4 f029                          breq OBS2_CHOQUE
                                 
0001d5 3014                          cpi r17, 4
0001d6 f019                          breq OBS2_CHOQUE
                                 
0001d7 3015                          cpi r17, 5
0001d8 f009                          breq OBS2_CHOQUE
                                 
0001d9 9508                          ret
                                 
                                 OBS2_CHOQUE:
                                 
0001da d001                          rcall DETENER_JUEGO
0001db 9508                          ret
                                 
                                 ;***********************************************
                                 ; DETENER_JUEGO
                                 ;
                                 ; Se ejecuta cuando hay choque.
                                 ; Detiene el juego, detiene los timers,
                                 ; apaga la matriz, pero NO borra PORTB.
                                 ; Por eso el display queda con el último número.
                                 ;***********************************************
                                 DETENER_JUEGO:
                                 
                                 	; juego_activo = 2
                                 	; Estado game over
0001dc e002                      	ldi r16, 0x02
0001dd 9300 0100                 	sts juego_activo, r16
                                 
                                 	; Bloquear botones
0001df e001                      	ldi r16, 1
0001e0 9300 0105                 	sts boton_lock, r16
                                 
                                     ; Detener Timer1
                                     ; Así el reloj deja de avanzar
                                     ; y los obstáculos no siguen bajando
0001e2 e000                          ldi r16, 0x00
0001e3 9300 0081                     sts TCCR1B, r16
                                 
                                     ; IMPORTANTE:
                                     ; No detener Timer0.
                                     ; Timer0 debe seguir refrescando la matriz.
                                 
                                     ; IMPORTANTE:
                                     ; No apagar PORTC ni PORTD.
                                     ; La matriz queda mostrando la última posición.
                                 
                                     ; IMPORTANTE:
                                     ; No tocar PORTB.
                                     ; El display queda con el último número registrado.
                                 
0001e5 9508                          ret
                                 
                                 ;***********************************************
                                 ; MOSTRAR_LED
                                 ;
                                 ; Entrada:
                                 ; r20 = columna 0 a 7
                                 ; r21 = fila 0 a 7
                                 ;***********************************************
                                 MOSTRAR_LED:
                                 
                                     ; Apagar momentáneamente la matriz
                                     ; Columna 8 y fila 8 quedan sin conexión
0001e6 e424                          ldi r18, 0b01000100
0001e7 b928                          out PORTC, r18
                                 
0001e8 e020                          ldi r18, 0b00000000
0001e9 b92b                          out PORTD, r18
                                 
0001ea d002                          rcall SET_COLUMNA
0001eb d00d                          rcall SET_FILA
                                 
0001ec 9508                          ret
                                 
                                 ;***********************************************
                                 ; SET_COLUMNA
                                 ;
                                 ; Entrada:
                                 ; r20 = columna
                                 ;
                                 ; PC2 -> S3
                                 ; PC3 -> S2
                                 ; PC4 -> S1
                                 ; PC5 -> S0
                                 ;***********************************************
                                 SET_COLUMNA:
                                 
                                     ; Limpiar PC2, PC3, PC4, PC5
                                     ; Mantener PC6 y PC1
0001ed b128                          in r18, PORTC
0001ee 7c23                          andi r18, 0b11000011
                                 
                                     ; bit 3 de r20 -> PC2
0001ef fd43                          sbrc r20, 3
0001f0 6024                          ori r18, 0b00000100
                                 
                                     ; bit 2 de r20 -> PC3
0001f1 fd42                          sbrc r20, 2
0001f2 6028                          ori r18, 0b00001000
                                 
                                     ; bit 1 de r20 -> PC4
0001f3 fd41                          sbrc r20, 1
0001f4 6120                          ori r18, 0b00010000
                                 
                                     ; bit 0 de r20 -> PC5
0001f5 fd40                          sbrc r20, 0
0001f6 6220                          ori r18, 0b00100000
                                 
0001f7 b928                          out PORTC, r18
                                 
0001f8 9508                          ret
                                 
                                 ;***********************************************
                                 ; SET_FILA
                                 ;
                                 ; Entrada:
                                 ; r21 = fila
                                 ;
                                 ; PC6 -> S3
                                 ; PD0 -> S2
                                 ; PD1 -> S1
                                 ; PD2 -> S0
                                 ;***********************************************
                                 SET_FILA:
                                 
                                     ; bit 3 de fila -> PC6
0001f9 b128                          in r18, PORTC
0001fa 7b2f                          andi r18, 0b10111111
                                 
0001fb fd53                          sbrc r21, 3
0001fc 6420                          ori r18, 0b01000000
                                 
0001fd b928                          out PORTC, r18
                                 
                                     ; bits 2,1,0 de fila -> PD0, PD1, PD2
0001fe b12b                          in r18, PORTD
0001ff 7f28                          andi r18, 0b11111000
                                 
                                     ; bit 2 de r21 -> PD0
000200 fd52                          sbrc r21, 2
000201 6021                          ori r18, 0b00000001
                                 
                                     ; bit 1 de r21 -> PD1
000202 fd51                          sbrc r21, 1
000203 6022                          ori r18, 0b00000010
                                 
                                     ; bit 0 de r21 -> PD2
000204 fd50                          sbrc r21, 0
000205 6024                          ori r18, 0b00000100
                                 
000206 b92b                          out PORTD, r18
                                 


